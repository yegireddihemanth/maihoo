# BGV Application Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ============================================
# AWS Configuration (for production)
# ============================================
AWS_REGION=us-east-1
SECRET_NAME=bgv-app/production
USE_AWS_SECRETS=false  # Set to 'true' on EC2 with IAM role

# ============================================
# Surepass API
# ============================================
SUREPASS_TOKEN=your_surepass_token_here

# ============================================
# MongoDB
# ============================================
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGO_DB_NAME=bgv_core

# ============================================
# OpenAI (Required for AI CV Validation)
# ============================================
OPENAI_API_KEY=sk-proj-your-openai-key-here

# ============================================
# Session Secret
# ============================================
SESSION_SECRET=your-super-secret-session-key-change-this

# ============================================
# Cloudinary (for file uploads)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# Gmail (for email notifications)
# ============================================
GMAIL_CREDENTIALS_PATH=token.json

# ============================================
# Application
# ============================================
ENVIRONMENT=development
PORT=8000
